<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!--
      UseWindowsForms fica DESLIGADO de proposito: o NotifyIcon do WinForms
      traria ~16 MB e um menu de contexto que nao segue tema escuro.
      A bandeja usa Hardcodet.NotifyIcon.Wpf, cujo menu e um ContextMenu WPF.
    -->
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>PrintDev</RootNamespace>
    <AssemblyName>PrintDev</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\PrintDev.ico</ApplicationIcon>
    <!-- Trimming e NativeAOT sao bloqueados pelo SDK para WPF (reflexao sobre BAML). -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrintDev.Core\PrintDev.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Build Action = Resource, NUNCA EmbeddedResource: fonte embutida como
      EmbeddedResource compila, roda e o WPF cai silenciosamente na fonte de reserva.
      Licencas OFL 1.1 acompanham os arquivos e pedem atribuicao.
    -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\PrintDev.ico" />
    <None Include="Assets\Fonts\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
