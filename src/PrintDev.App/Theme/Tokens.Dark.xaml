<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TEMA ESCURO - tokens de cor.

        Este dicionario e o UNICO que muda quando o tema troca, e por isso ele contem
        apenas cor. O ThemeService substitui o item de indice 0 dos MergedDictionaries do
        App.xaml, e todo DynamicResource reresolve sozinho, sem recriar janela nenhuma.

        Direcao: "Marca de Corte" - linguagem de prova de grafica. Neutros de tinta fria
        com leve vies violeta, e um unico ponto de calor.

        O acento e MAGENTA DE REGISTRO (#EC008C), e a escolha e tecnica, nao de gosto:
        e a unica familia de matiz com contraste equilibrado contra branco (4,25:1) E
        contra preto (4,94:1), e e a cor mais rara no conteudo que um dev captura - onde
        quase tudo e azul, cinza, branco e preto. O retangulo de selecao precisa aparecer
        por cima de QUALQUER coisa.
    -->

    <!-- ==== SUPERFICIES ==== -->
    <Color x:Key="Color.Surface.Sunken">#FF0A0B0F</Color>
    <Color x:Key="Color.Surface.Base">#FF0D0F14</Color>
    <Color x:Key="Color.Surface.Card">#FF131720</Color>
    <Color x:Key="Color.Surface.Elevated">#FF1A1F2B</Color>
    <!-- Camadas de estado: no escuro, clareiam. -->
    <Color x:Key="Color.Surface.Hover">#14FFFFFF</Color>
    <Color x:Key="Color.Surface.Press">#22FFFFFF</Color>
    <!-- Brilho de 1px no topo do card: e o que da volume sem precisar de sombra. -->
    <Color x:Key="Color.Surface.Highlight">#0AFFFFFF</Color>

    <!-- ==== BORDAS ==== -->
    <Color x:Key="Color.Border.Subtle">#FF212836</Color>
    <Color x:Key="Color.Border.Strong">#FF39435A</Color>
    <Color x:Key="Color.Border.Input">#FF2A3243</Color>

    <!-- ==== TEXTO (contraste medido contra Surface.Base) ==== -->
    <Color x:Key="Color.Text.Primary">#FFEEF1F7</Color>
    <Color x:Key="Color.Text.Secondary">#FFA2ACBF</Color>
    <Color x:Key="Color.Text.Tertiary">#FF77839A</Color>
    <Color x:Key="Color.Text.Disabled">#FF4E5A6E</Color>
    <!--
        Rotulo QUASE-PRETO sobre o magenta: 4,7:1. Texto branco sobre magenta daria
        3,58:1 e reprovaria em AA. E ao mesmo tempo mais acessivel e mais bonito - e a
        assinatura do botao primario.
    -->
    <Color x:Key="Color.Text.OnAccent">#FF0A0A0C</Color>

    <!-- ==== ACENTO - magenta de registro ==== -->
    <Color x:Key="Color.Accent.600">#FFC9007A</Color>
    <Color x:Key="Color.Accent.500">#FFEC008C</Color>
    <Color x:Key="Color.Accent.400">#FFFF3DA3</Color>
    <Color x:Key="Color.Accent.300">#FFFF8CC6</Color>
    <Color x:Key="Color.Accent.Subtle">#24EC008C</Color>
    <Color x:Key="Color.Accent.Ring">#59EC008C</Color>

    <!-- ==== SEMANTICAS ==== -->
    <Color x:Key="Color.Success">#FF3DDC97</Color>
    <Color x:Key="Color.Warning">#FFFFC245</Color>
    <Color x:Key="Color.Danger">#FFFF6250</Color>
    <Color x:Key="Color.Info">#FF57B6FF</Color>
    <Color x:Key="Color.Danger.Subtle">#24FF6250</Color>

    <!--
        ==== OVERLAY ====
        Nao mudam com o tema: o seletor e sempre escuro, porque aparece por cima do
        trabalho alheio.

        O veu e PRETO PURO, jamais tingido de magenta. O usuario esta julgando cor na
        tela capturada; contaminar o veu corromperia a percepcao dele.

        As tres cores do sanduiche formam a borda da selecao. A cor sozinha nunca garante
        contraste contra um fundo arbitrario - mas a sequencia escuro, cor, claro sempre
        tem uma das tres visivel, seja qual for o pixel embaixo.
    -->
    <Color x:Key="Color.Veil">#8C000000</Color>
    <Color x:Key="Color.Sandwich.Outer">#8C0A0A0C</Color>
    <Color x:Key="Color.Sandwich.Inner">#B3FFFFFF</Color>

    <!-- ==== PINCEIS - e o que a interface consome ==== -->
    <SolidColorBrush x:Key="Brush.Surface.Base" Color="{StaticResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="{StaticResource Color.Surface.Sunken}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Brush.Surface.Press" Color="{StaticResource Color.Surface.Press}" />
    <SolidColorBrush x:Key="Brush.Surface.Highlight" Color="{StaticResource Color.Surface.Highlight}" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Brush.Border.Input" Color="{StaticResource Color.Border.Input}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent.500}" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="{StaticResource Color.Accent.300}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" />
    <SolidColorBrush x:Key="Brush.Accent.Ring" Color="{StaticResource Color.Accent.Ring}" />

    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="{StaticResource Color.Danger.Subtle}" />

    <SolidColorBrush x:Key="Brush.Veil" Color="{StaticResource Color.Veil}" />
    <SolidColorBrush x:Key="Brush.Sandwich.Outer" Color="{StaticResource Color.Sandwich.Outer}" />
    <SolidColorBrush x:Key="Brush.Sandwich.Inner" Color="{StaticResource Color.Sandwich.Inner}" />

</ResourceDictionary>
