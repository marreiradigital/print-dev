<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Espaco, raio, sombra e movimento. NAO dependem de tema, entao ficam fora dos
        dicionarios de cor e podem ser consumidos com StaticResource, que e mais barato.

        ATENCAO: em .NET moderno o namespace System vem de System.Runtime, nao de
        mscorlib. Copiar o xmlns de um exemplo antigo faz o XAML compilar e falhar em
        tempo de execucao.
    -->

    <!-- ==== ESCALA DE ESPACO ==== -->

    <!--
        ==== ESPACOS SEMANTICOS ====
        E ISTO que a interface usa, nunca os numeros crus. O nome carrega a regra:
        quando alguem escreve Gap.LabelToControl, o valor certo vem junto.

        Nem todo espacamento do projeto passa por aqui: parte do XAML usa o numero
        direto. Os tokens que ninguem consumia foram removidos em vez de mantidos
        como promessa - token declarado e nao usado e pior que numero solto, porque
        finge uma regra que o codigo nao segue.

        Os minimos sao inegociaveis: nada pode ficar colado.
    -->
    <sys:Double x:Key="Gap.LabelToControl">6</sys:Double>
    <sys:Double x:Key="Gap.LabelToHint">4</sys:Double>
    <sys:Double x:Key="Gap.IconToText">8</sys:Double>
    <sys:Double x:Key="Gap.CardToCard">24</sys:Double>
    <sys:Double x:Key="Gap.ButtonToButton">10</sys:Double>
    <sys:Double x:Key="Gap.ToolbarItems">6</sys:Double>

    <!-- ==== PADDINGS ==== -->
    <Thickness x:Key="Pad.CardTight">16</Thickness>
    <Thickness x:Key="Pad.Row">20,14,20,14</Thickness>
    <Thickness x:Key="Pad.Button">16,0,16,0</Thickness>
    <Thickness x:Key="Pad.ButtonSmall">12,0,12,0</Thickness>
    <Thickness x:Key="Pad.Input">12,0,12,0</Thickness>
    <Thickness x:Key="Pad.Toolbar">6</Thickness>

    <!-- ==== ALTURAS ==== -->
    <sys:Double x:Key="Size.Control">36</sys:Double>
    <sys:Double x:Key="Size.ControlSmall">30</sys:Double>
    <sys:Double x:Key="Size.NavItem">36</sys:Double>
    <sys:Double x:Key="Size.Icon">20</sys:Double>

    <!--
        ==== RAIOS ====
        Pequenos de proposito. Isto e um instrumento de precisao, nao um aplicativo de
        celular: canto muito arredondado tira a sensacao de exatidao.
    -->
    <CornerRadius x:Key="Radius.XS">3</CornerRadius>
    <CornerRadius x:Key="Radius.SM">6</CornerRadius>
    <CornerRadius x:Key="Radius.MD">10</CornerRadius>
    <CornerRadius x:Key="Radius.LG">12</CornerRadius>
    <!-- A selecao NUNCA tem canto arredondado: ela precisa dizer exatamente onde corta. -->

    <!--
        ==== ELEVACAO ====
        Regra: no escuro, card NAO usa sombra - usa borda mais o brilho de 1px no topo.
        Sombra so em camada que realmente flutua.

        E sombra NUNCA em coisa que se move durante um arrasto: e o caminho mais curto
        para o seletor cair para 20 quadros por segundo em 3286x1080.
    -->
    <DropShadowEffect x:Key="Shadow.Popover" BlurRadius="32" ShadowDepth="10" Direction="270"
                      Opacity="0.50" Color="#000000" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shadow.Floating" BlurRadius="44" ShadowDepth="14" Direction="270"
                      Opacity="0.55" Color="#000000" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shadow.Card" BlurRadius="14" ShadowDepth="2" Direction="270"
                      Opacity="0.07" Color="#0B1020" RenderingBias="Performance" />

    <!--
        ==== MOVIMENTO ====
        Nenhum LinearEase no projeto inteiro: movimento linear parece mecanico porque
        nada no mundo fisico se move assim.
    -->

    <!-- Usado em exatamente DOIS lugares. Mais que isso vira desenho animado. -->

</ResourceDictionary>
