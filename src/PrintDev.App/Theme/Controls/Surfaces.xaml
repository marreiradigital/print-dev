<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:PrintDev.Controls">

    <!-- Cartao: agrupa configuracoes relacionadas. Maximo de cinco linhas por cartao;
         passando disso, quebra em dois com titulo proprio. -->
    <Style TargetType="ui:Card">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Card">
                    <Border CornerRadius="{DynamicResource Radius.MD}"
                            Background="{DynamicResource Brush.Surface.Card}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!--
                                Brilho de um pixel no topo. E o que da volume ao cartao no
                                tema escuro, onde sombra escura sobre fundo escuro nao
                                apareceria - e ainda custaria uma passada de desfoque.
                            -->
                            <Border VerticalAlignment="Top" Height="1"
                                    CornerRadius="10,10,0,0"
                                    Background="{DynamicResource Brush.Surface.Highlight}" />

                            <ui:Stack Spacing="0">
                                <TextBlock x:Name="Title"
                                           Style="{StaticResource Type.Subtitle}"
                                           Margin="20,16,20,0"
                                           Text="{TemplateBinding Title}" />
                                <ContentPresenter />
                            </ui:Stack>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Linha de configuracao.

        Todo o ritmo mora aqui: 20 de espacamento lateral, 14 em cima e embaixo, 4 entre
        o rotulo e a descricao. Definido UMA vez, valendo para o painel inteiro - mudar o
        ritmo do produto e editar este bloco.

        A descricao tem largura maxima para nunca correr por baixo do controle.
    -->
    <Style TargetType="ui:SettingRow">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SettingRow">
                    <Border Padding="{DynamicResource Pad.Row}" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ui:Stack Grid.Column="0"
                                      Spacing="{StaticResource Gap.LabelToHint}"
                                      VerticalAlignment="Center"
                                      Margin="0,0,20,0">
                                <TextBlock Style="{StaticResource Type.BodyMedium}"
                                           TextWrapping="Wrap"
                                           Text="{TemplateBinding Label}" />
                                <TextBlock x:Name="Description"
                                           Style="{StaticResource Type.Small}"
                                           TextWrapping="Wrap"
                                           MaxWidth="420"
                                           HorizontalAlignment="Left"
                                           Text="{TemplateBinding Description}" />
                            </ui:Stack>

                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Divisoria entre linhas do mesmo cartao, com recuo lateral. -->
    <Style x:Key="Row.Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="20,0,20,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Subtle}" />
    </Style>

    <!--
        Sub-ajuste: aparece so quando o ajuste-pai esta ligado, com recuo e uma barra
        vertical em acento. E o que mantem o painel curto para quem nao mexe em nada.
    -->
    <Style x:Key="Row.Nested" TargetType="Border">
        <Setter Property="Margin" Value="20,0,0,0" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Subtle}" />
    </Style>

    <!-- Previa de valor: mostra o resultado exato, em mono, dentro de um poco. -->
    <Style x:Key="Preview.Box" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.SM}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Input}" />
        <Setter Property="Padding" Value="10,7,10,7" />
    </Style>

</ResourceDictionary>
