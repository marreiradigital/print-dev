<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TEMA CLARO - as MESMAS chaves do tema escuro, com valores proprios.

        Nao e o escuro clareado. Tres coisas se invertem de verdade:

        1. A hierarquia. No escuro o card e mais CLARO que o fundo; aqui ele e branco
           puro sobre um cinza-papel frio. O card sobe pela luz, nao pelo tom.
        2. A camada de estado troca de sinal: branco a 8% vira preto a 6%. O mecanismo e
           o mesmo, so o token muda.
        3. As semanticas ESCURECEM. O verde #3DDC97 sobre branco da 1,9:1 e reprovaria
           em qualquer criterio de contraste; aqui ele e #12875A, que da 4,6:1.

        O que NAO muda: o acento base e o rotulo quase-preto sobre ele. O botao primario
        magenta com texto escuro e a assinatura da marca nos dois temas.
    -->

    <!-- ==== SUPERFICIES ==== -->
    <Color x:Key="Color.Surface.Sunken">#FFEAECF1</Color>
    <Color x:Key="Color.Surface.Base">#FFF4F5F8</Color>
    <Color x:Key="Color.Surface.Card">#FFFFFFFF</Color>
    <Color x:Key="Color.Surface.Elevated">#FFFFFFFF</Color>
    <!-- Camadas de estado: no claro, escurecem. -->
    <Color x:Key="Color.Surface.Hover">#0F10131A</Color>
    <Color x:Key="Color.Surface.Press">#1A10131A</Color>
    <!-- Sem brilho no topo: no claro ele nao teria contra o que aparecer. -->
    <Color x:Key="Color.Surface.Highlight">#00FFFFFF</Color>

    <!-- ==== BORDAS ==== -->
    <Color x:Key="Color.Border.Subtle">#FFE3E6EC</Color>
    <Color x:Key="Color.Border.Strong">#FFC6CCD6</Color>
    <Color x:Key="Color.Border.Input">#FFD3D8E1</Color>

    <!-- ==== TEXTO ==== -->
    <Color x:Key="Color.Text.Primary">#FF10131A</Color>
    <Color x:Key="Color.Text.Secondary">#FF525C6E</Color>
    <Color x:Key="Color.Text.Tertiary">#FF66707E</Color>
    <Color x:Key="Color.Text.Disabled">#FFA6ADBA</Color>
    <Color x:Key="Color.Text.OnAccent">#FF0A0A0C</Color>

    <!-- ==== ACENTO ==== -->
    <!-- A base e identica; o que muda e a direcao do hover: no claro ele ESCURECE. -->
    <Color x:Key="Color.Accent.600">#FFA8006B</Color>
    <Color x:Key="Color.Accent.500">#FFEC008C</Color>
    <Color x:Key="Color.Accent.400">#FFD1007C</Color>
    <Color x:Key="Color.Accent.300">#FFC9007A</Color>
    <Color x:Key="Color.Accent.Subtle">#1AEC008C</Color>
    <Color x:Key="Color.Accent.Ring">#4DEC008C</Color>

    <!-- ==== SEMANTICAS (escurecidas para terem contraste sobre branco) ==== -->
    <Color x:Key="Color.Success">#FF12875A</Color>
    <Color x:Key="Color.Warning">#FF9A6200</Color>
    <Color x:Key="Color.Danger">#FFD32F1F</Color>
    <Color x:Key="Color.Info">#FF0B69C7</Color>
    <Color x:Key="Color.Danger.Subtle">#1AD32F1F</Color>

    <!-- ==== OVERLAY - identico ao escuro: o seletor nao segue o tema ==== -->
    <Color x:Key="Color.Veil">#8C000000</Color>
    <Color x:Key="Color.Sandwich.Outer">#8C0A0A0C</Color>
    <Color x:Key="Color.Sandwich.Inner">#B3FFFFFF</Color>

    <!-- ==== PINCEIS ==== -->
    <SolidColorBrush x:Key="Brush.Surface.Base" Color="{StaticResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="{StaticResource Color.Surface.Sunken}" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource Color.Surface.Elevated}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Brush.Surface.Press" Color="{StaticResource Color.Surface.Press}" />
    <SolidColorBrush x:Key="Brush.Surface.Highlight" Color="{StaticResource Color.Surface.Highlight}" />

    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Border.Subtle}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource Color.Border.Strong}" />
    <SolidColorBrush x:Key="Brush.Border.Input" Color="{StaticResource Color.Border.Input}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="{StaticResource Color.Text.OnAccent}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent.500}" />
    <SolidColorBrush x:Key="Brush.Accent.Text" Color="{StaticResource Color.Accent.300}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource Color.Accent.Subtle}" />
    <SolidColorBrush x:Key="Brush.Accent.Ring" Color="{StaticResource Color.Accent.Ring}" />

    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Danger.Subtle" Color="{StaticResource Color.Danger.Subtle}" />

    <SolidColorBrush x:Key="Brush.Veil" Color="{StaticResource Color.Veil}" />
    <SolidColorBrush x:Key="Brush.Sandwich.Outer" Color="{StaticResource Color.Sandwich.Outer}" />
    <SolidColorBrush x:Key="Brush.Sandwich.Inner" Color="{StaticResource Color.Sandwich.Inner}" />

</ResourceDictionary>
