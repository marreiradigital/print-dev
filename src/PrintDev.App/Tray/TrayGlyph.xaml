<UserControl x:Class="PrintDev.Tray.TrayGlyph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="32" Height="32" Background="Transparent">
    <!--
        Icone da bandeja: quatro marcas de corte formando um quadrado vazado, com uma
        barra magenta cobrindo o canto inferior esquerdo. Marca de corte + tarja de
        censura = o produto inteiro num simbolo (recortar a tela, esconder o segredo).

        Desenhado em XAML e nao em .ico porque o TaskbarIcon aceita
        IconFrameworkElementSource e rasteriza no tamanho que o Windows pedir.

        A cor dos colchetes e clara porque a barra de tarefas do usuario esta no tema
        escuro. A variante para barra clara entra junto com o icone definitivo do app.
    -->
    <Grid>
        <Path Stroke="#F3F5F9"
              StrokeThickness="2.6"
              StrokeStartLineCap="Round"
              StrokeEndLineCap="Round"
              StrokeLineJoin="Round"
              Data="M 5,12 L 5,5 L 12,5
                    M 20,5 L 27,5 L 27,12
                    M 27,20 L 27,27 L 20,27
                    M 12,27 L 5,27 L 5,20" />

        <Rectangle Fill="#EC008C"
                   Width="14" Height="5"
                   RadiusX="1.5" RadiusY="1.5"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="3,19,0,0" />
    </Grid>
</UserControl>
