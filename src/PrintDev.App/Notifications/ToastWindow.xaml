<Window x:Class="PrintDev.Notifications.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:PrintDev.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="False"
        SizeToContent="Height"
        Width="380"
        Background="{DynamicResource Brush.Surface.Elevated}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        Aviso proprio, e nao o balao do Windows.

        O balao nativo e feio, chega atrasado, some sem aviso e pode estar desligado por
        politica de grupo - e ainda por cima nao aceita as acoes que interessam aqui.
        Este aparece no monitor onde a captura aconteceu, e traz o DESFAZER, que e a rede
        de seguranca que falta nos concorrentes.

        AllowsTransparency continua FALSE, como no resto do produto: os cantos
        arredondados vem do compositor do Windows, e a animacao de entrada anima o
        conteudo, nao a janela.
    -->

    <Border x:Name="Root"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border.Subtle}"
            Padding="{DynamicResource Pad.CardTight}"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" Y="12" />
        </Border.RenderTransform>

        <ui:Stack Spacing="{StaticResource Gap.LabelToControl}">

            <ui:Stack Orientation="Horizontal" Spacing="{StaticResource Gap.IconToText}">
                <!-- Miniatura: clicar nela abre a imagem. -->
                <Border x:Name="ThumbnailFrame"
                        Width="72" Height="52"
                        CornerRadius="{DynamicResource Radius.XS}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource Brush.Border.Strong}"
                        Background="{DynamicResource Brush.Surface.Sunken}"
                        ClipToBounds="True"
                        Cursor="Hand">
                    <Image x:Name="Thumbnail" Stretch="UniformToFill" />
                </Border>

                <ui:Stack Spacing="{StaticResource Gap.LabelToHint}" VerticalAlignment="Center">
                    <TextBlock x:Name="Headline"
                               Style="{StaticResource Type.BodyMedium}"
                               Text="Captura salva" />
                    <TextBlock x:Name="FileName"
                               Style="{StaticResource Type.MonoSmall}"
                               Foreground="{DynamicResource Brush.Text.Secondary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="252" />
                    <TextBlock x:Name="Dimensions"
                               Style="{StaticResource Type.MonoSmall}"
                               Foreground="{DynamicResource Brush.Text.Tertiary}" />
                </ui:Stack>
            </ui:Stack>

            <ui:Stack Orientation="Horizontal"
                      Spacing="{StaticResource Gap.ButtonToButton}"
                      HorizontalAlignment="Right"
                      Margin="0,4,0,0">
                <Button x:Name="AnnotateButton" Style="{StaticResource Button.Ghost}"
                        Content="Anotar" />
                <Button x:Name="CopyPathButton" Style="{StaticResource Button.Ghost}"
                        Content="Copiar caminho" />
                <Button x:Name="OpenButton" Style="{StaticResource Button.Ghost}"
                        Content="Abrir" />
                <Button x:Name="UndoButton" Style="{StaticResource Button.Danger}"
                        Content="Desfazer" />
            </ui:Stack>

        </ui:Stack>
    </Border>
</Window>
