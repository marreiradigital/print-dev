<Window x:Class="PrintDev.Pin.PinnedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="False"
        SizeToContent="WidthAndHeight"
        Background="{DynamicResource Brush.Surface.Elevated}"
        UseLayoutRounding="True"
        Cursor="SizeAll">

    <!--
        Captura fixada na tela, sempre por cima.

        Serve para comparar um desenho com a implementacao rodando, ou deixar um erro
        visivel enquanto se conserta - sem alternar de janela a cada dois segundos.

        Sem barra de titulo: a moldura de dois pixels ja diz onde a janela comeca, e uma
        barra roubaria altura de uma janela que o usuario quer o menor possivel.
    -->
    <Border x:Name="Frame"
            BorderThickness="2"
            BorderBrush="{DynamicResource Brush.Border.Strong}"
            Padding="0">
        <Grid>
            <Image x:Name="Picture" Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <!-- Dica de uso, some depois dos primeiros segundos. -->
            <Border x:Name="Hint"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,10"
                    CornerRadius="{DynamicResource Radius.SM}"
                    Background="#CC0A0A0C"
                    Padding="10,6,10,6">
                <TextBlock Style="{StaticResource Type.MonoSmall}"
                           Foreground="#FFEEF1F7"
                           Text="arraste para mover · roda amplia · Ctrl+roda dá transparência · Esc fecha" />
            </Border>
        </Grid>
    </Border>
</Window>
