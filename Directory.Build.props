<Project>

  <!--
    Configuracao comum aos tres projetos (Core, App, Tests).
    Ver docs/decisoes-de-arquitetura.md para o porque de cada escolha.
  -->

  <PropertyGroup>
    <!--
      TFM com versao do Windows SDK: habilita Windows.Media.Ocr (OCR nativo,
      sem dependencia externa) e Windows.UI.ViewManagement.UISettings.
      Adotado desde o commit 1 porque migrar depois obriga a re-restaurar tudo.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!--
      PlatformTarget fixa o processo em 64 bits (obrigatorio: varias estruturas de
      interoperacao tem tamanho diferente em 32 bits).

      <Platforms>x64</Platforms> foi REMOVIDO de proposito. Com ele, a solucao passava a
      ter a plataforma x64 e a saida ia para bind\Debug, enquanto compilar o projeto
      sozinho continuava indo para bin\Debug - duas pastas de saida para o mesmo codigo,
      e um executavel velho rodando sem ninguem perceber. Com apenas PlatformTarget a
      saida e sempre bin\Debug.
    -->
    <PlatformTarget>x64</PlatformTarget>

    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Print Dev</Product>
    <Company>Marreira Digital</Company>
    <Authors>Paulo Marreira</Authors>
    <Version>0.1.1</Version>
    <NeutralLanguage>pt-BR</NeutralLanguage>
    <Copyright>Copyright (c) 2026 Paulo Marreira</Copyright>
  </PropertyGroup>

  <!--
    Auditoria de dependencia no proprio restore: pacote vulneravel
    (inclusive transitivo, inclusive severidade baixa) quebra o build.
    Complementa a auditoria manual (dotnet list package, flag de vulnerabilidade)
    que roda a cada dependencia nova adicionada ao projeto.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

</Project>
